rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users Collection ──
    match /users/{uid} {
      // Any authenticated user can read (needed for leaderboard)
      allow read: if request.auth != null;

      // Users can only write their OWN document
      // Field validation: prevent injecting arbitrary large payloads
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   // For updates (merge:true), only check the fields being written
                   // For creates, check all fields
                   && (resource == null
                       ? request.resource.data.keys().hasOnly([
                           'displayName', 'totalXP', 'bestStreak', 'totalSolved',
                           'accuracy', 'isAnonymous', 'createdAt', 'updatedAt',
                           'stats', 'achievements', 'preferences',
                           'activeThemeId', 'activeCostume', 'activeTrailId', 'activeBadgeId',
                           'stickFigureStyle', 'weeklyXP', 'weeklyXPWeek',
                           'bestSpeedrunTime', 'speedrunHardMode', 'totalCorrect', 'sessionsPlayed',
                           'dayStreak', 'streakShields', 'lastPlayedDate', 'byType',
                           'hardModeSolved', 'hardModeCorrect', 'hardModeBestStreak', 'hardModeSessions', 'hardModePerfects',
                           'timedModeSolved', 'timedModeCorrect', 'timedModeBestStreak', 'timedModeSessions', 'timedModePerfects',
                           'ultimateSolved', 'ultimateCorrect', 'ultimateBestStreak', 'ultimateSessions', 'ultimatePerfects',
                           'lastPingAt', '_statsVersion',
                           'referralCode', 'referralCount',
                           'masteredWordsLevel5Plus', 'lastRoomCreateAt',
                           'friendCode'
                         ])
                       : request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'displayName', 'totalXP', 'bestStreak', 'totalSolved',
                           'accuracy', 'isAnonymous', 'createdAt', 'updatedAt',
                           'stats', 'achievements', 'preferences',
                           'activeThemeId', 'activeCostume', 'activeTrailId', 'activeBadgeId',
                           'stickFigureStyle', 'weeklyXP', 'weeklyXPWeek',
                           'bestSpeedrunTime', 'speedrunHardMode', 'totalCorrect', 'sessionsPlayed',
                           'dayStreak', 'streakShields', 'lastPlayedDate', 'byType',
                           'hardModeSolved', 'hardModeCorrect', 'hardModeBestStreak', 'hardModeSessions', 'hardModePerfects',
                           'timedModeSolved', 'timedModeCorrect', 'timedModeBestStreak', 'timedModeSessions', 'timedModePerfects',
                           'ultimateSolved', 'ultimateCorrect', 'ultimateBestStreak', 'ultimateSessions', 'ultimatePerfects',
                           'lastPingAt', '_statsVersion',
                           'referralCode', 'referralCount',
                           'masteredWordsLevel5Plus', 'lastRoomCreateAt',
                           'friendCode'
                         ])
                      )
                   // String field constraints
                   && (!('displayName' in request.resource.data)
                       || (request.resource.data.displayName is string
                           && request.resource.data.displayName.size() <= 20
                           && request.resource.data.displayName.matches('^[\\w\\s\\-_.!]{1,20}$')))
                   && (!('activeBadgeId' in request.resource.data)
                       || (request.resource.data.activeBadgeId is string
                           && request.resource.data.activeBadgeId.size() <= 50))
                   && (!('activeThemeId' in request.resource.data)
                       || (request.resource.data.activeThemeId is string
                           && request.resource.data.activeThemeId.size() <= 50))
                   && (!('activeCostume' in request.resource.data)
                       || (request.resource.data.activeCostume is string
                           && request.resource.data.activeCostume.size() <= 50))
                   && (!('activeTrailId' in request.resource.data)
                       || (request.resource.data.activeTrailId is string
                           && request.resource.data.activeTrailId.size() <= 50))
                   // Numeric field constraints + anti-spoofing caps
                   && (!('bestSpeedrunTime' in request.resource.data)
                       || (request.resource.data.bestSpeedrunTime is number
                           && request.resource.data.bestSpeedrunTime >= 0
                           && (request.resource.data.bestSpeedrunTime == 0
                               || request.resource.data.bestSpeedrunTime >= 5000)))  // can't finish 10 problems in < 5s
                   && (!('totalXP' in request.resource.data)
                       || (request.resource.data.totalXP is number
                           && request.resource.data.totalXP >= 0
                           && request.resource.data.totalXP <= 1000000
                           // Monotonic: can only increase (prevent arbitrary inflation)
                           && (resource == null || request.resource.data.totalXP >= resource.data.totalXP)
                           // Max +500 XP per write (prevents single-write exploits)
                           && (resource == null || !('totalXP' in resource.data) || request.resource.data.totalXP - resource.data.totalXP <= 500)))
                   && (!('bestStreak' in request.resource.data)
                       || (request.resource.data.bestStreak is number
                           && request.resource.data.bestStreak >= 0
                           && request.resource.data.bestStreak <= 1000
                           && (resource == null || request.resource.data.bestStreak >= resource.data.bestStreak)))
                   && (!('totalSolved' in request.resource.data)
                       || (request.resource.data.totalSolved is number
                           && request.resource.data.totalSolved >= 0
                           && request.resource.data.totalSolved <= 500000
                           && (resource == null || request.resource.data.totalSolved >= resource.data.totalSolved)))
                   && (!('accuracy' in request.resource.data)
                       || (request.resource.data.accuracy is number
                           && request.resource.data.accuracy >= 0
                           && request.resource.data.accuracy <= 100))                // percentage cap
                   // Consistency: totalCorrect must never exceed totalSolved
                   && (!('totalCorrect' in request.resource.data)
                       || (request.resource.data.totalCorrect is number
                           && request.resource.data.totalCorrect >= 0
                           && (resource == null || request.resource.data.totalCorrect >= resource.data.totalCorrect)
                           && (!('totalSolved' in request.resource.data)
                               || request.resource.data.totalCorrect <= request.resource.data.totalSolved)))
                   // dayStreak: monotonic, max 3650, max +7 per write (prevents single-write streak spoofing)
                   && (!('dayStreak' in request.resource.data)
                       || (request.resource.data.dayStreak is number
                           && request.resource.data.dayStreak >= 0
                           && request.resource.data.dayStreak <= 3650
                           && (resource == null || !('dayStreak' in resource.data)
                               || request.resource.data.dayStreak <= resource.data.dayStreak + 7
                               || request.resource.data.dayStreak == 1)))  // allow streak reset to 1
                   && (!('streakShields' in request.resource.data)
                       || (request.resource.data.streakShields is number
                           && request.resource.data.streakShields >= 0
                           && request.resource.data.streakShields <= 10))
                   && (!('stickFigureStyle' in request.resource.data)
                       || (request.resource.data.stickFigureStyle is string
                           && request.resource.data.stickFigureStyle.size() <= 200))
                   && (!('weeklyXP' in request.resource.data)
                       || (request.resource.data.weeklyXP is number
                           && request.resource.data.weeklyXP >= 0
                           && request.resource.data.weeklyXP <= 100000
                           // Allow reset to 0 (new week) or increase only
                           && (resource == null || request.resource.data.weeklyXP == 0 || request.resource.data.weeklyXP >= resource.data.weeklyXP)
                           // Max +500 per write (matches totalXP cap — prevents single-write inflation)
                           && (resource == null || !('weeklyXP' in resource.data)
                               || request.resource.data.weeklyXP == 0
                               || request.resource.data.weeklyXP - resource.data.weeklyXP <= 500)))
                   && (!('weeklyXPWeek' in request.resource.data)
                       || (request.resource.data.weeklyXPWeek is string
                           && request.resource.data.weeklyXPWeek.size() <= 10))
                   // Rate-limiting: reject writes less than 1s after last update
                   && (!(resource != null && 'updatedAt' in resource.data)
                       || request.time > resource.data.updatedAt + duration.value(1, 's'))
                   // Nested object size constraints (prevent payload bloat DoS)
                   && (!('stats' in request.resource.data)
                       || request.resource.data.stats is map)
                   && (!('achievements' in request.resource.data)
                       || request.resource.data.achievements is list)
                   && (!('preferences' in request.resource.data)
                       || request.resource.data.preferences is map)
                   && (!('byType' in request.resource.data)
                       || request.resource.data.byType is map)
                   // Referral & premium fields
                   && (!('referralCode' in request.resource.data)
                       || (request.resource.data.referralCode is string
                           && request.resource.data.referralCode.size() <= 20))
                   && (!('referralCount' in request.resource.data)
                       || (request.resource.data.referralCount is number
                           && request.resource.data.referralCount >= 0
                           && request.resource.data.referralCount <= 100))
                   // championPassExpiry is NOT client-writable — only Cloud Functions (admin SDK) can write it
                   && (!('friendCode' in request.resource.data)
                       || (request.resource.data.friendCode is string
                           && request.resource.data.friendCode.size() <= 10
                           && request.resource.data.friendCode.matches('^BEE-[A-Z2-9]{4}$')));
    }

    // ── Pings Collection (social nudges) ──
    match /pings/{pingId} {
      // Users can only read pings targeted at them
      allow read: if request.auth != null
                  && resource.data.targetUid == request.auth.uid;

      // Authenticated users can create pings (but not update/delete)
      // Rate-limited to 1 ping per 30 seconds per sender, enforced server-side.
      // Self-pings are blocked.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                         'targetUid', 'senderUid', 'senderName',
                         'createdAt', 'read',
                         'type', 'roomCode'
                       ])
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.senderUid != request.resource.data.targetUid
                    && request.resource.data.senderName is string
                    && request.resource.data.senderName.size() <= 20
                    && request.resource.data.targetUid is string
                    && request.resource.data.read == false
                    // Server-side rate limit: sender's lastPingAt must be > 30s ago
                    && (
                         !('lastPingAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
                         || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPingAt + duration.value(30, 's')
                       );

      // Only the target user can mark a ping as read
      allow update: if request.auth != null
                    && resource.data.targetUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Target user can delete their own pings (cleanup)
      allow delete: if request.auth != null
                    && resource.data.targetUid == request.auth.uid;
    }

    // ── Error Reports (monitoring) ──
    match /errors/{errorId} {
      // No reads — only admins via console
      allow read: if false;

      // Authenticated users can create error reports
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                         'message', 'stack', 'source', 'userAgent', 'url', 'timestamp'
                       ])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 500
                    && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() <= 2000))
                    && (!('source' in request.resource.data) || (request.resource.data.source is string && request.resource.data.source.size() <= 200))
                    && (!('userAgent' in request.resource.data) || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 200))
                    && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 500));

      allow update, delete: if false;
    }

    // ── Multiplayer Rooms ──
    match /rooms/{roomId} {
      // Any authenticated user can read rooms (needed for joining by code)
      allow read: if request.auth != null;

      // Authenticated users can create rooms (rate-limited: 1 per 10s)
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.roomCode is string
                    && request.resource.data.roomCode.size() == 6
                    && request.resource.data.status == 'waiting'
                    && (
                         !('lastRoomCreateAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
                         || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastRoomCreateAt + duration.value(10, 's')
                       );

      // Participants can update; non-participants can only join (add themselves to players)
      allow update: if request.auth != null
                    && (request.auth.uid in resource.data.players
                        || (resource.data.status == 'waiting'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])));

      // Only host can delete
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // ── Referrals (managed by Cloud Function, read-only for clients) ──
    match /referrals/{referralId} {
      // Participants can read their own referrals
      allow read: if request.auth != null
                  && (resource.data.referrerUid == request.auth.uid
                      || resource.data.inviteeUid == request.auth.uid);

      // Only Cloud Functions (admin SDK) can write
      allow write: if false;
    }

    // ── Daily Words (shared daily word community stats) ──
    match /dailyWords/{dateKey} {
      // Any authenticated user can read (community stats)
      allow read: if request.auth != null;

      // Auto-created/updated on first attempt via setDoc merge + increment
      allow create, update: if request.auth != null
                            && dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
                            && request.resource.data.keys().hasOnly([
                                 'word', 'difficulty', 'totalAttempts', 'correctCount', 'createdAt'
                               ])
                            && request.resource.data.word is string
                            && request.resource.data.word.size() <= 50
                            && request.resource.data.difficulty is number
                            && request.resource.data.difficulty >= 1
                            && request.resource.data.difficulty <= 10
                            && request.resource.data.totalAttempts is number
                            && request.resource.data.totalAttempts >= 0
                            && request.resource.data.correctCount is number
                            && request.resource.data.correctCount >= 0;

      allow delete: if false;

      // User attempts — one per user per day
      match /attempts/{uid} {
        allow read: if request.auth != null;

        // Users can only create their OWN attempt, once
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly([
                           'correct', 'attempts', 'timeMs', 'completedAt'
                         ])
                      && request.resource.data.correct is bool
                      && request.resource.data.attempts is number
                      && request.resource.data.attempts >= 1
                      && request.resource.data.attempts <= 10
                      && request.resource.data.timeMs is number
                      && request.resource.data.timeMs >= 0
                      && request.resource.data.timeMs <= 300000;

        allow update, delete: if false;
      }
    }

    // ── Testimonials (user feedback collection) ──
    match /testimonials/{testimonialId} {
      // Admin-only reads via console
      allow read: if false;

      // Authenticated users can submit testimonials (create only)
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                         'text', 'milestoneType', 'masteredCount', 'dayStreak',
                         'sessionsPlayed', 'level', 'isPremium', 'displayName', 'submittedAt'
                       ])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.text.size() <= 500;

      allow update, delete: if false;
    }

    // ── Friendships (buddy streaks + friend graph) ──
    match /friendships/{friendshipId} {
      // Only the two users in the friendship can read
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.uids;

      // Create: sender must be authenticated and in the uids array
      // Rate-limited: 1 friend request per 5 seconds (uses user doc updatedAt)
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.uids
                    && request.resource.data.requestedBy == request.auth.uid
                    // Self-friend prevention
                    && request.resource.data.uidA != request.resource.data.uidB
                    && request.resource.data.keys().hasOnly([
                         'uids', 'uidA', 'uidB', 'status', 'requestedBy',
                         'nameA', 'nameB', 'avatarA', 'avatarB', 'themeA', 'themeB',
                         'streakCount', 'lastActiveA', 'lastActiveB',
                         'streakLastDate', 'longestStreak',
                         'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.uids is list
                    && request.resource.data.uids.size() == 2
                    && request.resource.data.streakCount == 0
                    && request.resource.data.nameA is string
                    && request.resource.data.nameA.size() <= 20
                    && request.resource.data.nameB is string
                    && request.resource.data.nameB.size() <= 20;

      // Update: only participants; restricted fields
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.uids
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'nameA', 'nameB', 'avatarA', 'avatarB', 'themeA', 'themeB',
                         'streakCount', 'lastActiveA', 'lastActiveB',
                         'streakLastDate', 'longestStreak', 'updatedAt'
                       ])
                    // Status can only go pending → active (acceptance)
                    && (resource.data.status == request.resource.data.status
                        || (resource.data.status == 'pending'
                            && request.resource.data.status == 'active'
                            && request.auth.uid != resource.data.requestedBy))
                    && request.resource.data.streakCount is number
                    && request.resource.data.streakCount >= 0
                    && request.resource.data.streakCount <= 3650;

      // Either participant can delete (unfriend)
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.uids;
    }

    // ── Friend Codes (reverse lookup for adding friends) ──
    match /friendCodes/{code} {
      // Anyone authenticated can look up a friend code
      allow read: if request.auth != null;

      // Users can only create their own code entry
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid is string;

      // No updates or deletes (codes are permanent)
      allow update, delete: if false;
    }

    // ── TTS Rate Limiting (managed by Cloud Function, no client access) ──
    match /ttsRateLimit/{docId} {
      allow read, write: if false;
    }

    // ── Deploy Health (written by Cloud Function, admin-only read) ──
    match /deployHealth/{docId} {
      allow read, write: if false;
    }

    // ── Web Vitals (performance monitoring) ──
    match /vitals/{vitalId} {
      allow read: if false;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly([
                         'name', 'value', 'rating', 'navigationType', 'userAgent', 'timestamp'
                       ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 10
                    && request.resource.data.value is number
                    && request.resource.data.rating is string
                    && request.resource.data.rating.size() <= 20;

      allow update, delete: if false;
    }
  }
}
